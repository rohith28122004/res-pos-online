  "fixed_sql": [
    {
      "name": "client_link",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"client_link\" (\"singleton\" INTEGER NOT NULL DEFAULT 1 CHECK(\"singleton\" = 1), \"device_id\" TEXT NOT NULL, \"role\" TEXT NOT NULL, \"device_name\" TEXT NOT NULL, \"restaurant_id\" TEXT NOT NULL, \"restaurant_name\" TEXT NOT NULL, \"host_device_id\" TEXT NOT NULL, \"host_epoch\" INTEGER NOT NULL, \"host_addresses_json\" TEXT NOT NULL, \"host_port\" INTEGER NOT NULL, \"cert_sha256\" TEXT NOT NULL, \"signing_public_key\" TEXT NOT NULL, \"seal_public_key\" TEXT NOT NULL, \"cloud_url\" TEXT NULL, \"paired_at\" INTEGER NOT NULL, \"cursor_epoch\" INTEGER NOT NULL DEFAULT 0, \"cursor_sequence\" INTEGER NOT NULL DEFAULT 0, \"last_live_at\" INTEGER NULL, PRIMARY KEY (\"singleton\"));"
        }
      ]
    },
    {
      "name": "client_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"client_sessions\" (\"singleton\" INTEGER NOT NULL DEFAULT 1 CHECK(\"singleton\" = 1), \"staff_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"role\" TEXT NOT NULL, \"expires_at\" INTEGER NOT NULL, PRIMARY KEY (\"singleton\"));"
        }
      ]
    },
    {
      "name": "pending_commands",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pending_commands\" (\"command_id\" TEXT NOT NULL, \"staff_id\" TEXT NOT NULL, \"action\" TEXT NOT NULL, \"aggregate_id\" TEXT NULL, \"body_json\" TEXT NOT NULL, \"summary\" TEXT NOT NULL, \"state\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" INTEGER NOT NULL DEFAULT 0, \"last_route\" TEXT NULL, \"mailbox_state\" TEXT NULL, \"result_json\" TEXT NULL, \"error_code\" TEXT NULL, \"error_message\" TEXT NULL, PRIMARY KEY (\"command_id\"));"
        }
      ]
    },
    {
      "name": "drafts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drafts\" (\"id\" TEXT NOT NULL, \"staff_id\" TEXT NOT NULL, \"order_type\" TEXT NOT NULL, \"table_id\" TEXT NULL, \"table_label\" TEXT NULL, \"order_id\" TEXT NULL, \"guest_count\" INTEGER NULL, \"lines_json\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
