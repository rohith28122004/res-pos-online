        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ticket_alerts\" (\"ticket_id\" TEXT NOT NULL, \"alerted_at\" INTEGER NOT NULL, \"sounded\" INTEGER NOT NULL CHECK (\"sounded\" IN (0, 1)), PRIMARY KEY (\"ticket_id\"));"
        }
